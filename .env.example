# Copy to .env and fill in. Never commit .env.
# Azure AI Foundry (used by agent.py / evaluate.py / app.py)
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_API_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic/
AZURE_ANTHROPIC_DEPLOYMENT_NAME=
# Triage: put these two lines in single_collector/.env_typesafe (not .env)
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.12
# Django UI (optional; defaults are local-only)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
